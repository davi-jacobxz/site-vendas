# Supabase (publishable/anon key is protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=[PREENCHER]
NEXT_PUBLIC_SUPABASE_ANON_KEY=[PREENCHER]

# Meta Pixel numeric ID
NEXT_PUBLIC_META_PIXEL_ID=[PREENCHER]

# Optional Google Ads conversion ID
NEXT_PUBLIC_GOOGLE_ADS_ID=[PREENCHER]

# Never put SUPABASE_SERVICE_ROLE_KEY in NEXT_PUBLIC_*
# If a service-role integration is added later, keep it server-only.
